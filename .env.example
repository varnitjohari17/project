# Copy to .env and fill in what you have. Everything is optional: without keys the system
# runs fully locally (NumPy vector index + local extractive fallback / Qwen2.5-1.5B LLM).

# --- Google Gemini (Primary Multimodal Model for LLM, Vision & Video) ---
# GEMINI_API_KEY=AIzaSy...
# GOOGLE_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.5-flash         # or gemini-2.5-pro, gemini-2.0-flash, gemini-1.5-flash
# DESCRIBE_WITH_GEMINI=true             # use Gemini vision to describe photos, charts, and video scenes

# --- Video Ingestion Settings ---
# VIDEO_SAMPLE_FPS=0.5                  # extract 1 keyframe every 2 seconds
# VIDEO_MAX_FRAMES=30                   # maximum keyframes sampled per video

# --- Pinecone (managed vector database) ---
# PINECONE_API_KEY=pcsk_xxx
# PINECONE_REGION=us-east-1

# --- Hugging Face Inference API (alternative) ---
# HF_TOKEN=hf_xxx
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# --- Any OpenAI-compatible server instead (Ollama, vLLM, LM Studio, Groq...) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=

# --- Force a backend (default: auto -> gemini if key present, else local) ---
# LLM_BACKEND=auto                      # auto | gemini | hf | openai | local | extractive
# VECTOR_BACKEND=auto                   # auto | pinecone | local
# LLM_VISION=true                       # send retrieved photos, diagrams & video frames to the LLM

# --- Retrieval tuning ---
# TOP_K=5
# TEXT_EMBED_MODEL=BAAI/bge-small-en-v1.5
# RERANK_MODEL=BAAI/bge-reranker-base
